{
  "name": "merit-badge-massacre",
  "productName": "Merit Badge Massacre",
  "version": "1.0.0",
  "description": "Troop 13 vs. the Cult of the Antlered One. A survivors-like of cute damnation.",
  "author": "Tevded",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "audio:voice": "node tools/voice/dump_lines.cjs && python tools/voice/gen.py",
    "audio:music": "electron tools/render && node tools/render/encode.cjs",
    "audio:music:test": "node tools/render/selftest.cjs",
    "audio:manifest": "node tools/manifest.cjs"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.teddy.meritbadgemassacre",
    "productName": "Merit Badge Massacre",
    "files": [
      "index.html",
      "js/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "dir"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
